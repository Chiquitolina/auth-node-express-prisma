# No subir el .env real a Git
NODE_ENV=production
HOST=127.0.0.1
PORT=3004
# JWT_SECRET: minimo 32 caracteres aleatorios. No reutilizar el secreto de Render sin evaluar sesiones existentes.
JWT_SECRET=
# MySQL: mantener primero la DB actual; migrar solo despues de hacer backup y probar los datos.
DATABASE_URL=
# Gmail con contraseña de aplicación (no la contraseña principal)
GMAIL_USER=
GMAIL_PASS=
# En produccion, mismo origen: dejar vacio; para angular dev local usar http://localhost:4200
CORS_ORIGIN=
